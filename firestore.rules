rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the user logged in?
    function isAuthenticated() {
      return request.auth != null;
    }

    // --- USERS & PROFILES ---
    // Anyone logged in can view profiles (only first names, skills, interests stored)
    // Users can ONLY create or update their own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false; // Profiles shouldn't be deleted accidentally
    }

    // --- EVENTS ---
    // Anyone logged in can browse and create events
    // Logged in users can join/leave events
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated(); // For attendee count / attendee list
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;

      // Event Attendees subcollection
      match /attendees/{attendeeId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && request.auth.uid == attendeeId;
      }
    }

    // --- CONNECTION REQUESTS ("Say Hi") ---
    // Sender can create a request
    // Only sender or receiver can read or update (accept/decline)
    match /requests/{requestId} {
      allow create: if isAuthenticated() && request.resource.data.fromUserId == request.auth.uid;
      allow read, update: if isAuthenticated() && 
        (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow delete: if isAuthenticated() && resource.data.fromUserId == request.auth.uid;
    }

    // --- CHATS & MESSAGES (1-on-1 and Groups) ---
    // Security Rule: Users can ONLY read and write chats they are part of!
    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.members;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.members;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.members;

      // Chat Messages subcollection
      match /messages/{messageId} {
        // Can only read/write messages if member of parent chat
        allow read, write: if isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }
    }

    // --- REPORTS & BLOCKS (Safety) ---
    // Authenticated users can submit reports
    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reportedBy == request.auth.uid;
      allow read: if false; // Only admin console can read reports
    }

    match /blocks/{blockId} {
      allow create, read, delete: if isAuthenticated() && resource.data.blockedBy == request.auth.uid;
    }
  }
}
